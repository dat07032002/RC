+VescPacketValuesSelective::VescPacketValuesSelective(std::shared_ptr<VescFrame> raw)
+: VescPacket("ValuesSelective", raw),
+  rpm_(0.0),
+  v_in_(0.0),
+  tachometer_(0),
+  tachometer_abs_(0),
+  fault_code_(0)
+{
+  // Fixed mask: RPM (7), input voltage (8), tachometer (13), absolute
+  // tachometer (14), and fault code (15). The response echoes the mask.
+  auto at = [this](int index) -> uint8_t {return *(payload_.first + index);};
+  auto int32_at = [&at](int index) -> int32_t {
+      return static_cast<int32_t>(
+        (static_cast<uint32_t>(at(index)) << 24) |
+        (static_cast<uint32_t>(at(index + 1)) << 16) |
+        (static_cast<uint32_t>(at(index + 2)) << 8) |
+        static_cast<uint32_t>(at(index + 3)));
+    };
+  const int32_t rpm_raw = int32_at(5);
+  const int16_t voltage_raw = static_cast<int16_t>(
+    (static_cast<uint16_t>(at(9)) << 8) | static_cast<uint16_t>(at(10)));
+  rpm_ = static_cast<double>(rpm_raw);
+  v_in_ = static_cast<double>(voltage_raw) / 10.0;
+  tachometer_ = int32_at(11);
+  tachometer_abs_ = int32_at(15);
+  fault_code_ = at(19);
+}
+
+double VescPacketValuesSelective::rpm() const {return rpm_;}
+double VescPacketValuesSelective::v_in() const {return v_in_;}
+int32_t VescPacketValuesSelective::tachometer() const {return tachometer_;}
+int32_t VescPacketValuesSelective::tachometer_abs() const {return tachometer_abs_;}
+int VescPacketValuesSelective::fault_code() const {return fault_code_;}
+
+REGISTER_PACKET_TYPE(COMM_GET_VALUES_SELECTIVE, VescPacketValuesSelective)
+
+VescPacketRequestValuesSelective::VescPacketRequestValuesSelective()
+: VescPacket("RequestValuesSelective", 5, COMM_GET_VALUES_SELECTIVE)
+{
+  constexpr uint32_t MASK =
+    (1u << 7) | (1u << 8) | (1u << 13) | (1u << 14) | (1u << 15);
+  *(payload_.first + 1) = static_cast<uint8_t>(MASK >> 24);
+  *(payload_.first + 2) = static_cast<uint8_t>(MASK >> 16);
+  *(payload_.first + 3) = static_cast<uint8_t>(MASK >> 8);
+  *(payload_.first + 4) = static_cast<uint8_t>(MASK);
+  uint16_t crc = CRC::Calculate(
+    &(*payload_.first), std::distance(payload_.first, payload_.second), VescFrame::CRC_TYPE);
+  *(frame_->end() - 3) = static_cast<uint8_t>(crc >> 8);
+  *(frame_->end() - 2) = static_cast<uint8_t>(crc & 0xFF);
+}
