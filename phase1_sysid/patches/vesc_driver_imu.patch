diff --git a/vesc_driver/src/vesc_packet.cpp b/vesc_driver/src/vesc_packet.cpp
index 1cb9980..41c4e4a 100644
--- a/vesc_driver/src/vesc_packet.cpp
+++ b/vesc_driver/src/vesc_packet.cpp
@@ -413,6 +413,83 @@ VescPacketRequestValues::VescPacketRequestValues()
 
 /*------------------------------------------------------------------------------------------------*/
 
+// VESC "portable" float format used by COMM_GET_IMU_DATA (buffer_append_float32_auto).
+// Mirrors buffer_get_float32_auto() from the VESC firmware's buffer.c.
+static double buffer_get_float32_auto(const uint8_t * buf, int * index)
+{
+  uint32_t res =
+    (static_cast<uint32_t>(buf[*index]) << 24) |
+    (static_cast<uint32_t>(buf[*index + 1]) << 16) |
+    (static_cast<uint32_t>(buf[*index + 2]) << 8) |
+    (static_cast<uint32_t>(buf[*index + 3]));
+  *index += 4;
+
+  int e = (res >> 23) & 0xFF;
+  uint32_t sig_i = res & 0x7FFFFF;
+  bool neg = (res & (1u << 31)) != 0;
+
+  float sig = 0.0f;
+  if (e != 0 || sig_i != 0) {
+    sig = static_cast<float>(sig_i) / (8388608.0f * 2.0f) + 0.5f;
+    e -= 126;
+  }
+  if (neg) {
+    sig = -sig;
+  }
+  return static_cast<double>(ldexpf(sig, e));
+}
+
+VescPacketImu::VescPacketImu(std::shared_ptr<VescFrame> raw)
+: VescPacket("ImuData", raw), mask_(0)
+{
+  for (int i = 0; i < 16; ++i) {
+    vals_[i] = 0.0;
+  }
+  const uint8_t * p = &(*(payload_.first + 1));   // skip the COMM id byte
+  int idx = 0;
+  mask_ = (static_cast<uint16_t>(p[0]) << 8) | static_cast<uint16_t>(p[1]);
+  idx += 2;
+  for (int bit = 0; bit < 16; ++bit) {
+    if (mask_ & (1u << bit)) {
+      vals_[bit] = buffer_get_float32_auto(p, &idx);
+    }
+  }
+}
+
+uint16_t VescPacketImu::mask() const {return mask_;}
+double VescPacketImu::roll()   const {return vals_[0];}
+double VescPacketImu::pitch()  const {return vals_[1];}
+double VescPacketImu::yaw()    const {return vals_[2];}
+double VescPacketImu::acc_x()  const {return vals_[3];}
+double VescPacketImu::acc_y()  const {return vals_[4];}
+double VescPacketImu::acc_z()  const {return vals_[5];}
+double VescPacketImu::gyro_x() const {return vals_[6];}
+double VescPacketImu::gyro_y() const {return vals_[7];}
+double VescPacketImu::gyro_z() const {return vals_[8];}
+double VescPacketImu::mag_x()  const {return vals_[9];}
+double VescPacketImu::mag_y()  const {return vals_[10];}
+double VescPacketImu::mag_z()  const {return vals_[11];}
+double VescPacketImu::q_w()    const {return vals_[12];}
+double VescPacketImu::q_x()    const {return vals_[13];}
+double VescPacketImu::q_y()    const {return vals_[14];}
+double VescPacketImu::q_z()    const {return vals_[15];}
+
+REGISTER_PACKET_TYPE(COMM_GET_IMU_DATA, VescPacketImu)
+
+VescPacketRequestImu::VescPacketRequestImu()
+: VescPacket("RequestImuData", 3, COMM_GET_IMU_DATA)
+{
+  // payload: [COMM id][mask hi][mask lo]; mask 0xFFFF -> return all fields
+  *(payload_.first + 1) = 0xFF;
+  *(payload_.first + 2) = 0xFF;
+  uint16_t crc = CRC::Calculate(
+    &(*payload_.first), std::distance(payload_.first, payload_.second), VescFrame::CRC_TYPE);
+  *(frame_->end() - 3) = static_cast<uint8_t>(crc >> 8);
+  *(frame_->end() - 2) = static_cast<uint8_t>(crc & 0xFF);
+}
